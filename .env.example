# Database Configuration
DATABASE_URL=postgresql+asyncpg://radiologist:radiologist_password@localhost:5432/radiologist_db

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# AI Models
MODEL_PATH=./model_weights
USE_GPU=true

# Storage
DICOM_STORAGE_PATH=./storage/dicom
HEATMAP_STORAGE_PATH=./storage/heatmaps
REPORT_STORAGE_PATH=./storage/reports

# Logging
LOG_LEVEL=INFO
LOG_FILE=radiologist_assistant.log

# HIPAA Compliance
ENABLE_AUDIT_LOG=true
ENCRYPTION_AT_REST=true

# Performance
MAX_UPLOAD_SIZE_MB=100
BATCH_SIZE=32
NUM_WORKERS=4
